{
    # 對外 HTTPS 由 Cloudflare Tunnel 處理；Caddy 只在內部網路提供 HTTP，不簽發或管理憑證（2026-11-11）
    auto_https off

    log default {
        exclude http.log.error
    }

    log sanitized_errors {
        output stderr
        include http.log.error
        format filter {
            request delete
            wrap json
        }
    }
}

:80 {
    route {
        # 管理 API 僅由獨立管理網站轉發。
        @management path /api/admin /api/admin/*
        handle @management {
            respond 404
        }

        # 團隊電腦專用的內部 API 只走 Access 保護的內部 hostname，不從公開網站轉發
        handle_path /api/internal/* {
            respond 404
        }

        handle_path /api/* {
            reverse_proxy backend:8000
        }

        handle {
            root * /usr/share/caddy
            try_files {path} /index.html
            file_server
        }
    }
}
