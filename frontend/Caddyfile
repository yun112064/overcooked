{
    log default {
        exclude http.log.error
    }

    log sanitized_errors {
        output stderr
        include http.log.error
        format filter {
            request delete
            wrap json
        }
    }
}

:80 {
    handle_path /api/* {
        reverse_proxy backend:8000
    }

    handle {
        root * /usr/share/caddy
        try_files {path} /index.html
        file_server
    }
}
