# T17 團隊電腦設定範例：複製為 deploy/team/.env.team 後填入真實值（不進 Git）。
# 檢查：python -m ops.preflight team --env-file deploy/team/.env.team

# 團隊電腦 named tunnel 權杖（cloudflared service install 使用；只在這台電腦）
TEAM_TUNNEL_TOKEN=replace_with_cloudflare_tunnel_token

# 與雲端 .env.prod 相同的隨機字串（至少 32 字元）
INFERENCE_TOKEN=replace_with_random_token
KNOWLEDGE_SERVICE_TOKEN=replace_with_random_token
ASSISTANT_SERVICE_TOKEN=replace_with_random_token

# 本機資料庫（deploy/team/compose.yaml）
KNOWLEDGE_DB_PASSWORD=replace_with_random_password
ASSISTANT_DB_PASSWORD=replace_with_random_password
ASSISTANT_RERANKER_MODEL_DIR=D:/AIPE04期末專題_data/assistant_rag/models/bge-reranker-v2-m3

# 雲端內部 API：飲食小幫手經雲端模型生成回答、知識補抓佇列與建索引。
# 團隊電腦不需要也不可設定雲端 DATABASE_URL
CLOUD_INTERNAL_URL=https://cloud-internal.example.com
CLOUD_INTERNAL_TOKEN=replace_with_random_token
# 內部 hostname 的 Cloudflare Access 服務權杖（團隊電腦專用，與雲端呼叫團隊電腦的權杖不同）
CLOUD_ACCESS_CLIENT_ID=replace_with_access_client_id
CLOUD_ACCESS_CLIENT_SECRET=replace_with_access_client_secret

# 備份：本機備份根與另一顆磁碟／另一台主機的獨立位置
TEAM_BACKUP_ROOT=D:/AIPE04期末專題_backups
BACKUP_MIRROR_ROOT=E:/meal-planner-offsite
BACKUP_RETENTION_DAYS=7
# 飲食小幫手原始語料目錄（選用；db.env 不會被備份）
ASSISTANT_DATA_DIR=D:/AIPE04期末專題_data/assistant_rag
