# 本機開發環境設定（scripts/start-dev.ps1 讀取）。
# 複製成 .env.dev 後依自己電腦修改；.env.dev 不進 Git。
# 與 .env（docker compose 正式啟動用）分開，互不影響。

# --- 資料庫（Docker 容器，資料存在具名 volume，刪容器不會刪資料） ---
DEV_DB_CONTAINER=overcooked-dev-db
DEV_DB_VOLUME=overcooked-dev-pgdata
DEV_DB_PORT=55432
DEV_DB_NAME=meal_planner_dev
DEV_DB_PASSWORD=replace_with_random_password

# --- 後端 ---
# 上傳照片等執行資料放在專案外；第一次啟動會自動建立
PROJECT_DATA_ROOT=../AIPE04期末專題_data
ALLOWED_ORIGINS=http://localhost:5173
# 資料庫沒有食譜時，啟動腳本會自動從這份工作簿匯入（相對於專案根目錄）
RECIPE_WORKBOOK=data/recipe_dataset_1027.xlsx

# --- YOLO 推論服務（拍照辨識蔬菜） ---
# 權重檔已放在 Git（inference/models/）。YOLO_PYTHON 留空時，啟動腳本會自動建立 .venv-yolo
# 並安裝 Ultralytics（第一次需下載 PyTorch，約數分鐘）；已有訓練環境可填它的 python.exe 路徑。
# 不需要辨識時設 DEV_SKIP_YOLO=1，辨識會顯示不可用、仍可手動輸入。
YOLO_PYTHON=
INFERENCE_WEIGHTS=
DEV_SKIP_YOLO=
# 有 NVIDIA GPU 且 PyTorch 支援 CUDA 時可改為 0
INFERENCE_DEVICE=cpu
INFERENCE_PORT=8765
# 後端與推論服務共用的隨機字串
INFERENCE_TOKEN=replace_with_random_token

# --- T11 營養知識 RAG 與 OpenAI 向量化（決策 #23） ---
# start-dev 會在同一個資料庫容器建立 <DEV_DB_NAME>_knowledge、套用 knowledge_rag/schema.sql 並啟動知識服務。
# 不需要時設 DEV_SKIP_KNOWLEDGE=1，知識說明顯示不可用、不影響其他功能。
DEV_SKIP_KNOWLEDGE=
# 留空時自動設為 http://127.0.0.1:<KNOWLEDGE_PORT>（本機知識服務）
KNOWLEDGE_SERVICE_URL=
KNOWLEDGE_PORT=8766
# 下面兩個 token 留空時，start-dev 第一次執行會產生隨機值寫回 .env.dev（不顯示在畫面上）
KNOWLEDGE_SERVICE_TOKEN=
# 知識管理指令（knowledge_rag.admin）呼叫本機後端內部 API（crawl --queued、index build）用
INTERNAL_API_TOKEN=
# 健康醫療網書面授權證據的存放位置（crawl 必填；由人工填寫，例如 docs/authorizations/healthnews-permission.pdf）
KNOWLEDGE_AUTHORIZATION_REF=
# 查詢與建索引的向量化、菜單生成都需要；留空時付費功能不可用。付費呼叫一律先經 T10 額度預留
OPENAI_API_KEY=

# --- T02 全聯查價（決策 #23） ---
# start-dev 會啟動單一排程程序（每日 03:00 查價），並在啟動時於背景補跑／續跑今天的查價（約 12 分鐘）。
# 不需要時設 DEV_SKIP_PRICES=1，成本會顯示缺價。
DEV_SKIP_PRICES=
# 食材間限速（秒）；不要調低，見 docs/T02-pricing.md
PRICE_COLLECTION_DELAY_SECONDS=1.5

# T11 小知識說明（knowledge-tips）的生成供應者：預設 openai；改用本機 Ollama 時取消註解並填網址。
# 留空的模型／供應者會蓋掉後端預設，所以不用時保持註解。
# KNOWLEDGE_EXPLAIN_PROVIDER=openai
# KNOWLEDGE_EXPLAIN_MODEL=gpt-5.4-mini-2026-03-17
# KNOWLEDGE_OLLAMA_MODEL=qwen3.5:9b-q4_K_M
KNOWLEDGE_OLLAMA_URL=

# T04 營養證據綁定的資料版本（POST /meal-requests/{id}/t04-data）。預設三個都留空：端點回 422 NUTRITION_VERSION_REQUIRED。
# release_data 隨附的版本是 recipe-1103-v3-dd4f75c13772 / ca92a38b011998bf0e3b8163ce710c8b6228f8ecc0d71cf6e885ea25de6ba976 /
# food1018-v3-fd0e3666f627f0a8d6a4（綁定 1103_V3 工作簿，不是 demo 的 recipe_dataset_1027）；使用者確認綁定後才填入。
# 注意：只填這三個值仍會回 422 RECIPE_NUTRITION_RELEASE_MISMATCH——scripts/load_release_bundle.py 匯入的食譜版本是 active=false，
# 要等使用者決定如何綁定（是否啟用該版本）後才可能通過；不要自動啟用。
GENERATION_RECIPE_RELEASE_ID=
GENERATION_NUTRITION_IMPORT_ID=
GENERATION_FOOD_MAPPING_VERSION=

# 模擬超市：留空時交接回 503 MARKET_UNAVAILABLE。HANDOFF_KEY 為至少 32 bytes 的隨機字串，不要提交真實值。
# 網址：本機開發為 http://127.0.0.1:5174；只填 HANDOFF_KEY 時 start-dev 會自動設定網址並啟動 sim-supermarket。不要把超市網址加進 ALLOWED_ORIGINS。
SIM_MARKET_URL=
SIM_MARKET_HANDOFF_KEY=

# R14 飲食小幫手（assistant_rag 服務）：只有 Data Root 有 assistant_rag\db.env（或填了 ASSISTANT_DATABASE_URL）、
# 且已建好 overcooked-assistant-db／overcooked-assistant-reranker 容器時 start-dev 才啟動；缺任一項就略過。設 DEV_SKIP_ASSISTANT=1 一律略過。
DEV_SKIP_ASSISTANT=
# 留空時 start-dev 設為 http://127.0.0.1:<ASSISTANT_PORT>；token 留空時產生在 .dev\assistant-token（不進 Git）
ASSISTANT_SERVICE_URL=
ASSISTANT_SERVICE_TOKEN=
ASSISTANT_PORT=8093
# 設定埠號（例如 8094）才另外啟動 OpenAI 版小幫手；需要 OPENAI_API_KEY
ASSISTANT_OPENAI_PORT=
# OpenAI 版小幫手的網址由 start-dev 依 ASSISTANT_OPENAI_PORT 設定
# ASSISTANT_OPENAI_MODEL=gpt-5.4-mini-2026-03-17
# 小幫手服務本身的設定（assistant_rag 讀取，後端不讀）：向量資料庫、Data Root 下的資料目錄、Ollama、回答模型、重排服務
ASSISTANT_DATABASE_URL=
ASSISTANT_DATA_DIR=
RAG_OLLAMA_URL=
RAG_LLM_PROVIDER=
RAG_LLM_MODEL=
RAG_RERANK_URL=

# --- 其他後端設定可直接加在這裡（例如之後 T14 的 API key），會原樣傳給後端與 worker ---
