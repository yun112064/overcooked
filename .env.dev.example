# 本機開發環境設定（scripts/start-dev.ps1 讀取）。
# 複製成 .env.dev 後依自己電腦修改；.env.dev 不進 Git。
# 與 .env（docker compose 正式啟動用）分開，互不影響。

# --- 資料庫（Docker 容器，資料存在具名 volume，刪容器不會刪資料） ---
DEV_DB_CONTAINER=overcooked-dev-db
DEV_DB_VOLUME=overcooked-dev-pgdata
DEV_DB_PORT=55432
DEV_DB_NAME=meal_planner_dev
DEV_DB_PASSWORD=replace_with_random_password

# --- 後端 ---
# 上傳照片等執行資料放在專案外；第一次啟動會自動建立
PROJECT_DATA_ROOT=../AIPE04期末專題_data
ALLOWED_ORIGINS=http://localhost:5173
# 資料庫沒有食譜時，啟動腳本會自動從這份工作簿匯入（相對於專案根目錄）
RECIPE_WORKBOOK=data/recipe_dataset_1017.xlsx

# --- YOLO 推論服務（拍照辨識蔬菜） ---
# 權重檔已放在 Git（inference/models/）。YOLO_PYTHON 留空時，啟動腳本會自動建立 .venv-yolo
# 並安裝 Ultralytics（第一次需下載 PyTorch，約數分鐘）；已有訓練環境可填它的 python.exe 路徑。
# 不需要辨識時設 DEV_SKIP_YOLO=1，辨識會顯示不可用、仍可手動輸入。
YOLO_PYTHON=
INFERENCE_WEIGHTS=
DEV_SKIP_YOLO=
# 有 NVIDIA GPU 且 PyTorch 支援 CUDA 時可改為 0
INFERENCE_DEVICE=cpu
INFERENCE_PORT=8765
# 後端與推論服務共用的隨機字串
INFERENCE_TOKEN=replace_with_random_token

# --- T11 營養知識 RAG 與 OpenAI 向量化（決策 #23） ---
# start-dev 會在同一個資料庫容器建立 <DEV_DB_NAME>_knowledge、套用 knowledge_rag/schema.sql 並啟動知識服務。
# 不需要時設 DEV_SKIP_KNOWLEDGE=1，知識說明顯示不可用、不影響其他功能。
DEV_SKIP_KNOWLEDGE=
# 留空時自動設為 http://127.0.0.1:<KNOWLEDGE_PORT>（本機知識服務）
KNOWLEDGE_SERVICE_URL=
KNOWLEDGE_PORT=8766
# 下面兩個 token 留空時，start-dev 第一次執行會產生隨機值寫回 .env.dev（不顯示在畫面上）
KNOWLEDGE_SERVICE_TOKEN=
# 知識管理指令（knowledge_rag.admin）呼叫本機後端內部 API（crawl --queued、index build）用
INTERNAL_API_TOKEN=
# 健康醫療網書面授權證據的存放位置（crawl 必填；由人工填寫，例如 docs/authorizations/healthnews-permission.pdf）
KNOWLEDGE_AUTHORIZATION_REF=
# 查詢與建索引的向量化、菜單生成都需要；留空時付費功能不可用。付費呼叫一律先經 T10 額度預留
OPENAI_API_KEY=

# --- T02 全聯查價（決策 #23） ---
# start-dev 會啟動單一排程程序（每日 03:00 查價），並在啟動時於背景補跑／續跑今天的查價（約 12 分鐘）。
# 不需要時設 DEV_SKIP_PRICES=1，成本會顯示缺價。
DEV_SKIP_PRICES=
# 食材間限速（秒）；不要調低，見 docs/T02-pricing.md
PRICE_COLLECTION_DELAY_SECONDS=1.5

# --- 其他後端設定可直接加在這裡（例如之後 T14 的 API key），會原樣傳給後端與 worker ---
