  "domains": [
    "recipe",
    "ingredient",
    "price",
    "source_policy"
  ],
  "permission_check": "server-side on every request and command commit",
  "no_implicit_capabilities": [
    "household_rows.read",
    "t04.approve",
    "t04.write",
    "knowledge.publish",
    "sql.execute",
    "external.execute"
  ],
  "review_guards": [
    "active_grant",
    "domain_scope",
    "not_revision_contributor",
    "exact_revision_hash",
    "exact_dependency_hash",
    "validation_fresh"
  ],
  "publish_guards": [
    "active_grant",
    "domain_scope",
    "not_any_revision_contributor",
    "independent_content_approval",
    "independent_source_rights_approval",
    "all_pins_match",
    "no_blocking_issues"
  ],
  "grant_guards": [
    "no_self_grant_or_revoke",
    "no_self_role_elevation",
    "target_existing_user",
    "role_allowlist",
    "target_scope_subset_of_actor_scope",
    "preserve_last_access_admin",
    "access_revision",
    "audit_atomic"
  ],
  "external_execution_enabled": false
}
