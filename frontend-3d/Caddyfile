{
    log default {
        exclude http.log.error
    }

    log sanitized_errors {
        output stderr
        include http.log.error
        format filter {
            request delete
            wrap json
        }
    }
}

:80 {
    # 團隊電腦專用的內部 API 只走 Access 保護的內部 hostname，不從公開網站轉發
    handle_path /api/internal/* {
        respond 404
    }

    # 管理 API 只由獨立管理網站轉發，消費者網站不提供
    handle_path /api/admin/* {
        respond 404
    }

    handle_path /api/* {
        reverse_proxy backend:8000 {
            # 飲食小幫手（POST /api/assistant/chat）用 SSE 串流，不能被緩衝
            flush_interval -1
        }
    }

    handle {
        root * /usr/share/caddy
        try_files {path} /index.html
        file_server
    }
}
