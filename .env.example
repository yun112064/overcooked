# Database settings for T06.
POSTGRES_PASSWORD=replace_with_random_password
DATABASE_URL=postgresql+psycopg://postgres:replace_with_random_password@localhost:5432/meal_planner

# T04 development settings; formal use of LLM cooking factors is pending.
# See docs/T04-T06-merge-pending.md (P01).
# Copy to .env in the project root and fill the key locally.
# CLI loads cwd/.env; its LLM settings override process variables.
# Supports single-line quoted values, comments and export; no interpolation.
# Never share or commit a real API key.
NUTRITION_LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
