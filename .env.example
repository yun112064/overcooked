# Database settings for T06.
POSTGRES_PASSWORD=replace_with_random_password
DATABASE_URL=postgresql+psycopg://postgres:replace_with_random_password@localhost:5432/meal_planner

# Host paths for Data / Runtime / Backup roots (mounted by compose.yaml).
# Keep them outside the Code Root; never commit real data.
PROJECT_DATA_ROOT=../AIPE04期末專題_data
PROJECT_RUNTIME_ROOT=../AIPE04期末專題_runtime
PROJECT_BACKUP_ROOT=../AIPE04期末專題_backups

# T07 login: allowed frontend origins for state-changing requests (comma separated).
# Keep COOKIE_SECURE=true except for plain-http testing on a non-localhost host.
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173
COOKIE_SECURE=true

# T02 runs in a separate scheduler process (never inside FastAPI workers).
# Local path below is relative to the repository root. In Compose the workbook
# is expected at /app/data/recipe_dataset_1027.xlsx on the data volume.
PRICE_SCHEDULER_ENABLED=true
PRICE_SCHEDULER_HOUR=3
PRICE_SCHEDULER_MINUTE=0
PRICE_SCHEDULER_TIMEZONE=Asia/Taipei
PRICE_WORKBOOK_PATH=data/recipe_dataset_1027.xlsx
PRICE_COLLECTION_DELAY_SECONDS=1.5
PRICE_COLLECTION_TIMEOUT_SECONDS=15
PRICE_COLLECTION_RETRIES=1
PRICE_COLLECTION_BATCH_SIZE=0
# 決策 #25：全聯查無／不可用的食材改查萬家福（每請求間隔 ≥2 秒）
PRICE_FALLBACK_UNI_PROSPERITY_ENABLED=true

# T04 development settings; formal use of LLM cooking factors is pending.
# See docs/T04-T06-merge-pending.md (P01).
# Copy to .env in the project root and fill the key locally.
# CLI loads cwd/.env; its LLM settings override process variables.
# Supports single-line quoted values, comments and export; no interpolation.
# Never share or commit a real API key.
NUTRITION_LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# T09 team-computer YOLO inference service (HTTPS or an encrypted tunnel).
# Leave empty to run with recognition shown as unavailable (manual input still works).
RECOGNITION_SERVICE_URL=
RECOGNITION_SERVICE_TOKEN=

# T11 team-computer nutrition knowledge RAG (HTTPS or an encrypted tunnel) and OpenAI embeddings.
# Leave empty to show knowledge as unavailable. Paid calls always go through T10 reservations.
# Never commit a real API key.
KNOWLEDGE_SERVICE_URL=
KNOWLEDGE_SERVICE_TOKEN=
OPENAI_API_KEY=

# T11 小知識說明（knowledge-tips）的生成供應者：預設 openai；改用本機 Ollama 時取消註解並填網址。
# 留空的模型／供應者會蓋掉後端預設，所以不用時保持註解。
# KNOWLEDGE_EXPLAIN_PROVIDER=openai
# KNOWLEDGE_EXPLAIN_MODEL=gpt-5.4-mini-2026-03-17
# KNOWLEDGE_OLLAMA_MODEL=qwen3.5:9b-q4_K_M
KNOWLEDGE_OLLAMA_URL=

# T04 營養證據綁定的資料版本（POST /meal-requests/{id}/t04-data）。預設三個都留空：端點回 422 NUTRITION_VERSION_REQUIRED。
# release_data 隨附的版本是 recipe-1103-v3-dd4f75c13772 / ca92a38b011998bf0e3b8163ce710c8b6228f8ecc0d71cf6e885ea25de6ba976 /
# food1018-v3-fd0e3666f627f0a8d6a4（綁定 1103_V3 工作簿，不是 demo 的 recipe_dataset_1027）；使用者確認綁定後才填入。
# 注意：只填這三個值仍會回 422 RECIPE_NUTRITION_RELEASE_MISMATCH——scripts/load_release_bundle.py 匯入的食譜版本是 active=false，
# 要等使用者決定如何綁定（是否啟用該版本）後才可能通過；不要自動啟用。
GENERATION_RECIPE_RELEASE_ID=
GENERATION_NUTRITION_IMPORT_ID=
GENERATION_FOOD_MAPPING_VERSION=

# 模擬超市：留空時交接回 503 MARKET_UNAVAILABLE。HANDOFF_KEY 為至少 32 bytes 的隨機字串，不要提交真實值。
# 網址：compose 的 --profile sim-market 為 http://127.0.0.1:8081。不要把超市網址加進 ALLOWED_ORIGINS。
SIM_MARKET_URL=
SIM_MARKET_HANDOFF_KEY=

# R14 飲食小幫手（assistant_rag 服務）：留空時小幫手頁顯示未啟用。
ASSISTANT_SERVICE_URL=
ASSISTANT_SERVICE_TOKEN=
# OpenAI 版小幫手（選用）：回答經後端 /internal/assistant/chat 呼叫 OpenAI（T10 額度）。
ASSISTANT_OPENAI_SERVICE_URL=
# ASSISTANT_OPENAI_MODEL=gpt-5.4-mini-2026-03-17
# 小幫手服務本身的設定（assistant_rag 讀取，後端不讀）：向量資料庫、Data Root 下的資料目錄、Ollama、回答模型、重排服務
ASSISTANT_DATABASE_URL=
ASSISTANT_DATA_DIR=
RAG_OLLAMA_URL=
RAG_LLM_PROVIDER=
RAG_LLM_MODEL=
RAG_RERANK_URL=
# 以下兩個只給 scripts/start-dev.ps1 使用（本機開發請寫在 .env.dev，見 .env.dev.example）；compose 不讀取。
DEV_SKIP_ASSISTANT=
ASSISTANT_OPENAI_PORT=
