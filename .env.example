# Database settings for T06.
POSTGRES_PASSWORD=replace_with_random_password
DATABASE_URL=postgresql+psycopg://postgres:replace_with_random_password@127.0.0.1:55435/meal_planner_1102_v3

# Host paths for Data / Runtime / Backup roots (mounted by compose.yaml).
# Keep them outside the Code Root; never commit real data.
PROJECT_DATA_ROOT=../AIPE04期末專題_data
PROJECT_RUNTIME_ROOT=../AIPE04期末專題_runtime
PROJECT_BACKUP_ROOT=../AIPE04期末專題_backups

# T07 login: allowed frontend origins for state-changing requests (comma separated).
# Keep COOKIE_SECURE=true except for plain-http testing on a non-localhost host.
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173
COOKIE_SECURE=true

# T02 runs in a separate scheduler process (never inside FastAPI workers).
# Local path below is relative to the repository root. In Compose the workbook
# is expected at /app/data/recipe_dataset_1103_V3.xlsx on the data volume.
PRICE_SCHEDULER_ENABLED=false
PRICE_SCHEDULER_HOUR=3
PRICE_SCHEDULER_MINUTE=0
PRICE_SCHEDULER_TIMEZONE=Asia/Taipei
PRICE_WORKBOOK_PATH=data/recipe_dataset_1103_V3.xlsx
PRICE_COLLECTION_DELAY_SECONDS=2.0
PRICE_COLLECTION_TIMEOUT_SECONDS=15
PRICE_COLLECTION_RETRIES=1
PRICE_COLLECTION_BATCH_SIZE=0

# T04 development settings; formal use of LLM cooking factors is pending.
# See docs/T04-T06-merge-pending.md (P01).
# Copy to .env in the project root and fill the key locally.
# CLI loads cwd/.env; its LLM settings override process variables.
# Supports single-line quoted values, comments and export; no interpolation.
# Never share or commit a real API key.
NUTRITION_LLM_PROVIDER=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# T09 team-computer YOLO inference service (HTTPS or an encrypted tunnel).
# Leave empty to run with recognition shown as unavailable (manual input still works).
RECOGNITION_SERVICE_URL=
RECOGNITION_SERVICE_TOKEN=

# 1102_V3: select versions only after reviewing docs/1102_V3/SOURCES.md.
GENERATION_RECIPE_RELEASE_ID=recipe-1103-v3-dd4f75c13772
GENERATION_NUTRITION_IMPORT_ID=ca92a38b011998bf0e3b8163ce710c8b6228f8ecc0d71cf6e885ea25de6ba976
GENERATION_FOOD_MAPPING_VERSION=food1018-v3-fd0e3666f627f0a8d6a4
T12_PREVIEW_CONVERSION=t04
KNOWLEDGE_PROVIDER=ollama
KNOWLEDGE_SERVICE_URL=
KNOWLEDGE_SERVICE_TOKEN=
KNOWLEDGE_INTERNAL_TOKEN=
OPENAI_API_KEY=
