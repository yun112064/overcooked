# Database settings for T06.
POSTGRES_PASSWORD=replace_with_random_password
DATABASE_URL=postgresql+psycopg://postgres:replace_with_random_password@localhost:5432/meal_planner

# Host paths for Data / Runtime / Backup roots (mounted by compose.yaml).
# Keep them outside the Code Root; never commit real data.
PROJECT_DATA_ROOT=../AIPE04期末專題_data
PROJECT_RUNTIME_ROOT=../AIPE04期末專題_runtime
PROJECT_BACKUP_ROOT=../AIPE04期末專題_backups

# T02 runs in a separate scheduler process (never inside FastAPI workers).
# Local path below is relative to the repository root. In Compose the workbook
# is expected at /app/data/recipe_dataset_1017.xlsx on the data volume.
PRICE_SCHEDULER_ENABLED=true
PRICE_SCHEDULER_HOUR=3
PRICE_SCHEDULER_MINUTE=0
PRICE_SCHEDULER_TIMEZONE=Asia/Taipei
PRICE_WORKBOOK_PATH=data/recipe_dataset_1017.xlsx
PRICE_COLLECTION_DELAY_SECONDS=1.5
PRICE_COLLECTION_TIMEOUT_SECONDS=15
PRICE_COLLECTION_RETRIES=1
PRICE_COLLECTION_BATCH_SIZE=0

# T04 development settings; formal use of LLM cooking factors is pending.
# See docs/T04-T06-merge-pending.md (P01).
# Copy to .env in the project root and fill the key locally.
# CLI loads cwd/.env; its LLM settings override process variables.
# Supports single-line quoted values, comments and export; no interpolation.
# Never share or commit a real API key.
NUTRITION_LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
