# T17 雲端正式環境設定範例：複製為 .env.prod 後填入真實值（.env.prod 不進 Git）。
# 檢查：python -m ops.preflight cloud --env-file .env.prod
# 部署：python -m ops.deploy --env-file .env.prod
#
# 首次部署前先安裝真實食譜／營養資料包到新資料庫（見 docs/portable-nutrition.md），
# 再把輸出檔的 DATABASE_URL、NUTRITION_POLICY_MANIFEST_SHA256、GENERATION_* 、T12_PREVIEW_CONVERSION 填到下方：
#   docker compose --env-file .env.prod -f compose.yaml -f compose.prod.yaml up -d --wait db
#   docker compose --env-file .env.prod -f compose.yaml -f compose.prod.yaml run --rm --no-deps -w /app \
#     -e INSTALL_DATABASE_ADMIN_URL -v /opt/meal-planner/install:/app/.test-runtime backend \
#     python scripts/install_real_nutrition.py --database meal_planner_prod --output-env /app/.test-runtime/prod-db.env
#   （INSTALL_DATABASE_ADMIN_URL=postgresql+psycopg://postgres:<POSTGRES_PASSWORD>@db:5432/postgres 從環境變數帶入）

# ---- 對外網址（Cloudflare named tunnel；HTTPS 憑證由 Cloudflare 處理，Caddy 不處理憑證） ----
PUBLIC_HOSTNAME=meal.example.com
ALLOWED_ORIGINS=https://meal.example.com
COOKIE_SECURE=true
# Cloudflare Zero Trust → Networks → Tunnels 建立的 named tunnel 權杖
CLOUDFLARE_TUNNEL_TOKEN=replace_with_cloudflare_tunnel_token

# ---- 資料庫（只在 Compose 內部網路） ----
POSTGRES_PASSWORD=replace_with_random_password
DATABASE_URL=replace_with_install_real_nutrition_output
NUTRITION_POLICY_MANIFEST_SHA256=replace_with_install_real_nutrition_output
GENERATION_RECIPE_RELEASE_ID=
GENERATION_NUTRITION_IMPORT_ID=
GENERATION_FOOD_MAPPING_VERSION=
T12_PREVIEW_CONVERSION=factor_one

# ---- 主機路徑（絕對路徑；備份與獨立位置不可在 Data Root 之內） ----
PROJECT_DATA_ROOT=/opt/meal-planner/data
PROJECT_RUNTIME_ROOT=/opt/meal-planner/runtime
PROJECT_BACKUP_ROOT=/opt/meal-planner/backups
# 另一顆磁碟、另一台主機掛載的目錄或物件儲存掛載點
BACKUP_MIRROR_ROOT=/mnt/offsite/meal-planner
BACKUP_RETENTION_DAYS=7

# ---- 雲端模型（AI 菜單、知識說明、飲食小幫手回答；全部經 T10 額度控制） ----
OPENAI_API_KEY=replace_with_openai_api_key

# ---- 團隊電腦服務（經團隊電腦的 named tunnel；未設定時該功能顯示不可用） ----
RECOGNITION_SERVICE_URL=https://yolo.example.com
RECOGNITION_SERVICE_TOKEN=replace_with_random_token
KNOWLEDGE_SERVICE_URL=https://knowledge.example.com
KNOWLEDGE_SERVICE_TOKEN=replace_with_random_token
# 飲食小幫手：團隊電腦只做檢索，回答由雲端模型生成（engine=openai）
ASSISTANT_OPENAI_SERVICE_URL=https://assistant.example.com
ASSISTANT_SERVICE_TOKEN=replace_with_random_token
# 雲端呼叫團隊電腦三個 hostname 用的 Cloudflare Access 服務權杖
TEAM_ACCESS_CLIENT_ID=replace_with_access_client_id
TEAM_ACCESS_CLIENT_SECRET=replace_with_access_client_secret
# 團隊電腦呼叫雲端內部 API（cloud-internal.<網域>，含雲端模型生成）時核對的 Bearer token
INTERNAL_API_TOKEN=replace_with_random_token
