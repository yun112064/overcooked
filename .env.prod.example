# T17 正式環境（單機，整套跑在團隊電腦）設定範例：複製為 .env.prod 後填入真實值（.env.prod 不進 Git）。
#   檢查：python -m ops.preflight --env-file .env.prod
#   首次／更新：python -m ops.deploy --env-file .env.prod
#   平日啟動：.\scripts\prod-up.ps1          停止原生服務：.\scripts\prod-up.ps1 -Stop
#   每日備份：.\scripts\backup-daily.ps1     （.\scripts\install-prod-tasks.ps1 註冊工作排程器）
# 隨機值可用：python -c "import secrets; print(secrets.token_hex(32))"
#
# 首次部署前先安裝真實食譜／營養資料包到新資料庫，再把輸出檔的 DATABASE_URL、NUTRITION_POLICY_MANIFEST_SHA256、
# GENERATION_*、T12_PREVIEW_CONVERSION 填到下方（PowerShell）：
#   docker compose --env-file .env.prod -f compose.yaml -f compose.prod.yaml up -d --wait db
#   $env:INSTALL_DATABASE_ADMIN_URL = "postgresql+psycopg://postgres:<POSTGRES_PASSWORD>@db:5432/postgres"
#   docker compose --env-file .env.prod -f compose.yaml -f compose.prod.yaml run --rm --no-deps -w /app `
#     -e INSTALL_DATABASE_ADMIN_URL -v "${PWD}\.dev:/app/.test-runtime" backend `
#     python scripts/install_real_nutrition.py --database meal_planner_prod --output-env /app/.test-runtime/prod-db.env
#   Remove-Item env:INSTALL_DATABASE_ADMIN_URL

# ---- 對外網址（Cloudflare named tunnel；HTTPS 憑證由 Cloudflare 處理，Caddy 不處理憑證） ----
# 網域可用免費網域（例如 .dpdns.org、.eu.org）並把 DNS 託管到 Cloudflare
PUBLIC_HOSTNAME=meal.example.com
ALLOWED_ORIGINS=https://meal.example.com
COOKIE_SECURE=true
# Cloudflare Zero Trust → Networks → Tunnels 建立的 named tunnel 權杖；
# Public Hostname 只設一個：PUBLIC_HOSTNAME → http://frontend:80
CLOUDFLARE_TUNNEL_TOKEN=replace_with_cloudflare_tunnel_token

# ---- 業務資料庫（只在 Compose 內部網路；容器 meal-prod-db、volume meal-prod-pgdata） ----
POSTGRES_PASSWORD=replace_with_random_password
DATABASE_URL=replace_with_install_real_nutrition_output
NUTRITION_POLICY_MANIFEST_SHA256=replace_with_install_real_nutrition_output
GENERATION_RECIPE_RELEASE_ID=
GENERATION_NUTRITION_IMPORT_ID=
GENERATION_FOOD_MAPPING_VERSION=
T12_PREVIEW_CONVERSION=factor_one
# backend 只綁 127.0.0.1 的埠（同一台電腦的飲食小幫手回呼雲端模型用；避開開發環境的 8000）
PROD_BACKEND_PORT=18000

# ---- 知識庫、飲食小幫手庫與重排（deploy/team/compose.yaml，埠只綁 127.0.0.1） ----
KNOWLEDGE_DB_PASSWORD=replace_with_random_password
ASSISTANT_DB_PASSWORD=replace_with_random_password
ASSISTANT_RERANKER_MODEL_DIR=D:/AIPE04期末專題_data/assistant_rag/models/bge-reranker-v2-m3
# 飲食小幫手原始語料目錄（選用；db.env 不會被備份）
ASSISTANT_DATA_DIR=D:/AIPE04期末專題_data/assistant_rag

# ---- 主機路徑（絕對路徑；備份與獨立位置不可在 Data Root 之內） ----
PROJECT_DATA_ROOT=D:/meal-prod/data
PROJECT_RUNTIME_ROOT=D:/meal-prod/runtime
PROJECT_BACKUP_ROOT=D:/meal-prod/backups
# 獨立位置：另一顆磁碟、隨身硬碟或雲端硬碟同步資料夾（不要和 PROJECT_BACKUP_ROOT 同一顆磁碟）
BACKUP_MIRROR_ROOT=E:/meal-prod-offsite
BACKUP_RETENTION_DAYS=7

# ---- 雲端模型（AI 菜單、知識說明、飲食小幫手回答；全部經 T10 額度控制） ----
OPENAI_API_KEY=replace_with_openai_api_key
# 飲食小幫手回呼 backend /internal/assistant/chat 時核對的 Bearer token
INTERNAL_API_TOKEN=replace_with_random_token

# ---- 同一台電腦的原生服務（scripts/prod-up.ps1 啟動；容器經 host.docker.internal 連線，未設定則顯示不可用） ----
RECOGNITION_SERVICE_URL=http://host.docker.internal:8765
RECOGNITION_SERVICE_TOKEN=replace_with_random_token
KNOWLEDGE_SERVICE_URL=http://host.docker.internal:8091
KNOWLEDGE_SERVICE_TOKEN=replace_with_random_token
# 飲食小幫手：本機只做檢索，回答由雲端模型生成（engine=openai）
ASSISTANT_OPENAI_SERVICE_URL=http://host.docker.internal:8094
ASSISTANT_SERVICE_TOKEN=replace_with_random_token
