# T17 雲端正式環境設定範例：複製為主機上的 /opt/meal-planner/code/.env.prod 後填入真實值（不進 Git）。
# 檢查：python -m ops.preflight cloud --env-file .env.prod（只列變數名稱，不印秘密值）

# 對外網域（Cloudflare 上的 Public Hostname）與 tunnel 權杖
PUBLIC_HOSTNAME=meal.example.com
CLOUDFLARE_TUNNEL_TOKEN=replace_with_cloudflare_tunnel_token
ALLOWED_ORIGINS=https://meal.example.com
COOKIE_SECURE=true

# 資料庫（只在 Compose 內部網路）
POSTGRES_PASSWORD=replace_with_random_password

# Spec 路徑：Data／Runtime／Backup；BACKUP_MIRROR_ROOT 必須是另一台主機或物件儲存的掛載點
PROJECT_DATA_ROOT=/var/lib/meal-planner/data
PROJECT_RUNTIME_ROOT=/var/lib/meal-planner/runtime
PROJECT_BACKUP_ROOT=/var/backups/meal-planner
BACKUP_MIRROR_ROOT=/mnt/meal-planner-offsite
BACKUP_RETENTION_DAYS=7
BACKUP_PG_CONTAINER=meal-planner-db
BACKUP_DATABASE=meal_planner
PRICE_WORKBOOK_PATH_CONTAINER=/app/data/recipe_dataset_1017.xlsx

# 團隊電腦服務（經團隊電腦的 Cloudflare Tunnel，前面有 Cloudflare Access）
RECOGNITION_SERVICE_URL=https://yolo.example.com
RECOGNITION_SERVICE_TOKEN=replace_with_random_token
KNOWLEDGE_SERVICE_URL=https://knowledge.example.com
KNOWLEDGE_SERVICE_TOKEN=replace_with_random_token
# Cloudflare Access 服務權杖（Zero Trust → Access → Service Auth）
TEAM_ACCESS_CLIENT_ID=replace_with_access_client_id
TEAM_ACCESS_CLIENT_SECRET=replace_with_access_client_secret

# 團隊電腦呼叫雲端內部 API（補抓佇列、建索引向量化）的 Bearer token（至少 32 字元；與團隊端 CLOUD_INTERNAL_TOKEN 相同）
INTERNAL_API_TOKEN=replace_with_random_token

# 付費模型（一律經 T10 額度預留）
OPENAI_API_KEY=
