# T17 正式環境設定（部署方式與 t11-t20-demo 相同：團隊電腦 Docker＋Cloudflare 快速通道）。
# .env.prod 由 .\scripts\prod-up.ps1 第一次執行時自動產生（隨機密碼與權杖，不進 Git），一般不需手寫；
# 這份範例只說明各鍵的用途。產生後通常只要補 BACKUP_MIRROR_ROOT。
#   啟動：.\scripts\prod-up.ps1        關閉：.\scripts\prod-down.ps1
#   小幫手語料與索引：.\scripts\assistant-data.ps1
#   每日備份：.\scripts\backup-daily.ps1（.\scripts\install-prod-tasks.ps1 註冊工作排程器）

# ---- 由 prod-up 寫入 ----
# 快速通道網址（每次重開都會變）
PUBLIC_HOSTNAME=
PROD_DATABASE=meal_planner_prod
# 主機原生 YOLO 的埠（避開開發 8765 與 demo 展示站 8775）
PROD_YOLO_PORT=8776

# ---- 隨機產生（各 64 字元） ----
POSTGRES_PASSWORD=replace_with_random_password
INFERENCE_TOKEN=replace_with_random_token
KNOWLEDGE_SERVICE_TOKEN=replace_with_random_token
KNOWLEDGE_DB_PASSWORD=replace_with_random_password
ASSISTANT_SERVICE_TOKEN=replace_with_random_token
ASSISTANT_DB_PASSWORD=replace_with_random_password
INTERNAL_API_TOKEN=replace_with_random_token

# ---- install_real_nutrition 輸出（第一次啟動時寫入） ----
DATABASE_URL=
NUTRITION_POLICY_MANIFEST=
NUTRITION_POLICY_MANIFEST_SHA256=
GENERATION_RECIPE_RELEASE_ID=
GENERATION_NUTRITION_IMPORT_ID=
GENERATION_FOOD_MAPPING_VERSION=
T12_PREVIEW_CONVERSION=

# ---- 主機路徑（絕對路徑；備份與獨立位置不可在 Data Root 之內） ----
PROJECT_DATA_ROOT=D:/meal-prod/data
PROJECT_RUNTIME_ROOT=D:/meal-prod/runtime
PROJECT_BACKUP_ROOT=D:/meal-prod/backups
# 飲食小幫手原文語料（Git 之外）與官方 BAAI/bge-reranker-v2-m3 權重
ASSISTANT_DATA_DIR=D:/AIPE04期末專題_data/assistant_rag
ASSISTANT_RERANKER_MODEL_DIR=D:/AIPE04期末專題_data/assistant_rag/models/bge-reranker-v2-m3
# 獨立位置：另一顆磁碟、隨身硬碟或雲端硬碟同步資料夾（每日備份會複製一份到這裡）
BACKUP_MIRROR_ROOT=
BACKUP_RETENTION_DAYS=7

# ---- 選用 ----
# 新版前端建置的 npm registry。預設使用 registry.npmjs.org；連線有問題時可指定其他可用來源。
NPM_CONFIG_REGISTRY=
# AI 菜單生成與知識說明（經 T10 額度控制）；飲食小幫手用本機 Ollama，不需要
OPENAI_API_KEY=
# YOLO 裝置（cpu 或 cuda:0）
INFERENCE_DEVICE=
# 飲食小幫手回答模型（Ollama）；預設 qwen3.5:9b-q4_K_M
ASSISTANT_LLM_MODEL=
# 重排容器映像：RTX 40 系列 89-1.9.4（預設）；RTX 50 系列 120-1.9.4
TEI_IMAGE_TAG=
